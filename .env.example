# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider (any OpenAI-compatible endpoint).
# LLM_PROVIDER presets: gemini (default) | groq | openai
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai/  model gemini-2.5-flash
#   groq   -> https://api.groq.com/openai/v1                            model llama-3.3-70b-versatile
#   openai -> https://api.openai.com/v1                                 model gpt-4o-mini
# LLM_BASE_URL / MODEL_NAME override the preset. Leave LLM_API_KEY empty to run
# in deterministic-only mode (no LLM calls; policy engine output only).
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_BASE_URL=
# MODEL_NAME=
# Client-side request-per-minute cap (stay under the free-tier limit).
LLM_RPM=8
