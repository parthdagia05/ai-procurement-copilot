# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider: any OpenAI-compatible endpoint, chosen by LLM_PROVIDER.
#   groq   (default) -> https://api.groq.com/openai/v1                            model openai/gpt-oss-20b (evaluated)
#   gemini           -> https://generativelanguage.googleapis.com/v1beta/openai/  model gemini-3.8-flash
#   openai           -> https://api.openai.com/v1                                 model gpt-4o-mini
# The provider-specific key (GROQ_API_KEY / GEMINI_API_KEY / OPENAI_API_KEY) wins over
# the generic LLM_API_KEY. LLM_BASE_URL and MODEL_NAME override the preset.
# With no key at all the copilot runs deterministic-only (policy engine, no LLM calls).
LLM_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=
# MODEL_NAME=

# Client-side request-per-minute cap (stay under the free-tier limit).
LLM_RPM=8
