# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# LLM provider (any OpenAI-compatible endpoint).
# LLM_PROVIDER presets: gemini (default) | groq | openai
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai/  model gemini-3.8-flash
#   groq   -> https://api.groq.com/openai/v1                            model openai/gpt-oss-120b
#   openai -> https://api.openai.com/v1                                 model gpt-4o-mini
# A provider-specific key (GROQ_API_KEY, GEMINI_API_KEY, OPENAI_API_KEY) takes
# precedence over LLM_API_KEY. LLM_BASE_URL / MODEL_NAME override the preset. Leave LLM_API_KEY empty to run
# in deterministic-only mode (no LLM calls; policy engine output only).
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_BASE_URL=
# MODEL_NAME=
# Client-side request-per-minute cap (stay under the free-tier limit).
LLM_RPM=8
GROQ_API_KEY=
# GEMINI_API_KEY=
